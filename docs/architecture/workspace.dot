digraph architecture {
rankdir=TB;
graph [bgcolor="transparent", pad="0.3", nodesep="0.35", ranksep="0.6", fontname="DejaVu Sans", fontsize=17];
node [shape=box, style="rounded,filled", color="#a4b4c8", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
edge [color="#64748b", fontcolor="#475569", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
http [label="WorkspaceHTTPApplication\nFastAPI composition + lifecycle", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-server-py", target="_top", tooltip="src/zombie_sim/server.py"];
controllers [label="ConfigurationHTTPController\nRunHTTPController / HTTPReadController\nLiveViewSession per socket", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-server-py", target="_top", tooltip="src/zombie_sim/server.py"];
ws [label="WorkspaceServices\nclose() / context manager", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-services-workspace-py", target="_top", tooltip="src/zombie_sim/services/workspace.py"];
manager [label="RunManager\napplication use cases + coordination", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-application-py", target="_top", tooltip="src/zombie_sim/application.py"];
repo [label="RunRepository\nmanager journal + registered runs", fillcolor="#e5f5eb", URL="code-index.html#src-zombie-sim-application-py", target="_top", tooltip="src/zombie_sim/application.py"];
supervisor [label="WorkerSupervisor\nprocess start · status · cleanup", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-application-py", target="_top", tooltip="src/zombie_sim/application.py"];
worker [label="RunWorker\nwriter lease + engine + control loop", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-application-py", target="_top", tooltip="src/zombie_sim/application.py"];
queries [label="HistoryQueryService\nWAL readers + bounded snapshot cache", fillcolor="#e5f5eb", URL="code-index.html#src-zombie-sim-application-py", target="_top", tooltip="src/zombie_sim/application.py"];
reads [label="ReadPool class\nordinary pool + separate export pool\ncancellable reader processes", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-read-tasks-py", target="_top", tooltip="src/zombie_sim/read_tasks.py"];
child [label="Read-only RunManager per reader child\nseparate repository, caches and registry", fillcolor="#e5f5eb", URL="code-index.html#src-zombie-sim-application-py", target="_top", tooltip="src/zombie_sim/application.py"];
child_queries [label="Child HistoryQueryService\nchild-owned WAL readers / caches", fillcolor="#e5f5eb", URL="code-index.html#src-zombie-sim-application-py", target="_top", tooltip="src/zombie_sim/application.py"];
child_analysis [label="Child analysis-service instances\nmetrics · comparison · timeline · visualization", fillcolor="#e5f5eb", URL="code-index.html#src-zombie-sim-metrics-py", target="_top", tooltip="src/zombie_sim/metrics.py"];
journal [label="manager.sqlite\nshared durable commands / run metadata", fillcolor="#e5f5eb"];
ops [label="ReadOperationRegistry\nexplicit operation → handler", fillcolor="#fff0d8", URL="code-index.html#src-zombie-sim-read-tasks-py", target="_top", tooltip="src/zombie_sim/read_tasks.py"];
analysis [label="MetricsService / ComparisonService\nTimelineService / SurvivalMeasurement\nVisualizationService", fillcolor="#e5f5eb", URL="code-index.html#src-zombie-sim-metrics-py", target="_top", tooltip="src/zombie_sim/metrics.py"];
exports [label="ExportJobs → ExportService\nExportRendererRegistry + 6 strategies", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-export-jobs-py", target="_top", tooltip="src/zombie_sim/export_jobs.py"];
shutdown [label="ShutdownCoordinator\ndrain · reconcile · stop · close", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-service-shutdown-py", target="_top", tooltip="src/zombie_sim/service_shutdown.py"];
commands [label="CommandReceiptService / ScriptCommandService\nimmutable request identity + recovery", fillcolor="#e8f2fc", URL="code-index.html#src-zombie-sim-command-recovery-py", target="_top", tooltip="src/zombie_sim/command_recovery.py"];
http -> ws [label="owns", style="solid"];
http -> controllers [label="", style="solid"];
controllers -> manager [label="", style="solid"];
controllers -> reads [label="", style="solid"];
ws -> manager [label="", style="solid"];
ws -> reads [label="", style="solid"];
ws -> exports [label="", style="solid"];
ws -> shutdown [label="", style="solid"];
manager -> repo [label="", style="solid"];
manager -> supervisor [label="", style="solid"];
manager -> queries [label="", style="solid"];
manager -> analysis [label="", style="solid"];
supervisor -> worker [label="one process / run", style="solid"];
worker -> journal [label="own journal connection", style="solid"];
repo -> journal [label="", style="solid"];
reads -> child [label="one per process", style="solid"];
child -> ops [label="", style="solid"];
child -> child_queries [label="", style="solid"];
child -> child_analysis [label="", style="solid"];
ops -> child_analysis [label="", style="solid"];
ops -> child_queries [label="", style="solid"];
child -> journal [label="read-only repository", style="solid"];
exports -> reads [label="creates own export pool", style="solid"];
commands -> repo [label="", style="solid"];
shutdown -> manager [label="", style="solid"];
shutdown -> exports [label="", style="solid"];
shutdown -> reads [label="", style="solid"];
}
