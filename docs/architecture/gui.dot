digraph architecture {
rankdir=LR;
graph [bgcolor="transparent", pad="0.3", nodesep="0.35", ranksep="0.6", fontname="DejaVu Sans", fontsize=17];
node [shape=box, style="rounded,filled", color="#a4b4c8", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
edge [color="#64748b", fontcolor="#475569", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
main [label="main.tsx → Workspace\nReact composition entrypoint", fillcolor="#e8f2fc", URL="code-index.html#gui-src-main-tsx", target="_top", tooltip="gui/src/main.tsx"];
views [label="Functional views\nConfiguration · World · InterventionDialog\ncharts · tables · inspection panels", fillcolor="#e8f2fc", URL="code-index.html#gui-src-views-configuration-tsx", target="_top", tooltip="gui/src/views/Configuration.tsx"];
api [label="ApiClient\ntransport + abort + instrumentation", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-apiclient-ts", target="_top", tooltip="gui/src/core/ApiClient.ts"];
observable [label="ObservableController\nsubscribe / notify / cleanup", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-observablecontroller-ts", target="_top", tooltip="gui/src/core/ObservableController.ts"];
catalog [label="RunCatalog\nmonotonic summaries + polling", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-runcatalog-ts", target="_top", tooltip="gui/src/core/RunCatalog.ts"];
editor [label="ConfigurationEditor\natomic draft + validation + preview + launch", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-configurationeditor-ts", target="_top", tooltip="gui/src/core/ConfigurationEditor.ts"];
command [label="CommandSession + ExecutionSession\nretained requests + receipt reconciliation", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-commandsession-ts", target="_top", tooltip="gui/src/core/CommandSession.ts"];
view [label="ViewSession\nseek generations + WS follow lifecycle", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-viewsession-ts", target="_top", tooltip="gui/src/core/ViewSession.ts"];
query [label="QueryReader\nsingle in-flight request + cancellation", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-queryreader-ts", target="_top", tooltip="gui/src/core/QueryReader.ts"];
readers [label="StatisticsReader / CohortReader\nEventsReader / ComparisonReader", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-analysisreaders-ts", target="_top", tooltip="gui/src/core/AnalysisReaders.ts"];
export [label="ExportSession\nexport job polling + cancellation", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-exportsession-ts", target="_top", tooltip="gui/src/core/ExportSession.ts"];
world [label="WorldRenderer\nCanvas scene + transforms + hit testing", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-worldrenderer-ts", target="_top", tooltip="gui/src/core/WorldRenderer.ts"];
plot [label="PopulationPresenter / ComparisonPresenter\nPlotlyHost serializes draw + purge", fillcolor="#e8f2fc", URL="code-index.html#gui-src-core-plotlyhost-ts", target="_top", tooltip="gui/src/core/PlotlyHost.ts"];
time [label="ExactTime / ExactCursor\nTimeValue / ExactTimeInput", fillcolor="#fff0d8", URL="code-index.html#gui-src-core-contracts-ts", target="_top", tooltip="gui/src/core/contracts.ts"];
main -> views [label="", style="solid"];
views -> catalog [label="owns / subscribes", style="solid"];
views -> editor [label="owns / subscribes", style="solid"];
views -> command [label="owns / subscribes", style="solid"];
views -> export [label="owns / subscribes", style="solid"];
catalog -> observable [label="extends", style="dashed"];
editor -> observable [label="extends", style="dashed"];
command -> observable [label="extends", style="dashed"];
