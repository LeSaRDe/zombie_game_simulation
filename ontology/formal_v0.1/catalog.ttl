@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zg: <urn:zombie-game:v0.1:> .

zg:DOCTOR a zg:HumanRoleDefinition ;
    rdfs:label "DOCTOR" ;
    zg:compatibleType zg:Human ;
    zg:grants zg:cap_prophylaxis,
        zg:cap_treat_infection ;
    zg:medical_skill 0.9 ;
    zg:prophylaxis_duration 120.0 ;
    zg:prophylaxis_resistance 0.8 ;
    zg:registry_version "baseline_v0.1" ;
    zg:treatment_cost 1 ;
    zg:treatment_duration 4.0 .

zg:ENGINEER a zg:HumanRoleDefinition ;
    rdfs:label "ENGINEER" ;
    zg:build_integrity 100 ;
    zg:build_material_cost 2 ;
    zg:carry_capacity 16 ;
    zg:compatibleType zg:Human ;
    zg:grants zg:cap_build_barricade,
        zg:cap_repair_barrier ;
    zg:registry_version "baseline_v0.1" ;
    zg:repair_amount 60 ;
    zg:repair_material_cost 1 .

zg:RUNNER a zg:ZombieRoleDefinition ;
    rdfs:label "RUNNER" ;
    zg:base_speed 3.2 ;
    zg:claw_damage 10 ;
    zg:compatibleType zg:Zombie ;
    zg:dash_duration 1.0 ;
    zg:dash_multiplier 1.5 ;
    zg:grants zg:cap_dash ;
    zg:registry_version "baseline_v0.1" .

zg:SCOUT a zg:HumanRoleDefinition ;
    rdfs:label "SCOUT" ;
    zg:base_sense_r 55.0 ;
    zg:base_speed 2.6 ;
    zg:compatibleType zg:Human ;
    zg:grants zg:cap_mark_target,
        zg:cap_recon ;
    zg:mark_radius 90.0 ;
    zg:recon_duration 12.0 ;
    zg:recon_radius 85.0 ;
    zg:registry_version "baseline_v0.1" .

zg:SCREAMER a zg:ZombieRoleDefinition ;
    rdfs:label "SCREAMER" ;
