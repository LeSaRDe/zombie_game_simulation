    zg:claw_damage 10 ;
    zg:compatibleType zg:Zombie ;
    zg:grants zg:cap_scream ;
    zg:registry_version "baseline_v0.1" .

zg:SPITTER a zg:ZombieRoleDefinition ;
    rdfs:label "SPITTER" ;
    zg:base_speed 1.4 ;
    zg:compatibleType zg:Zombie ;
    zg:grants zg:cap_spit ;
    zg:max_spit_charges 3 ;
