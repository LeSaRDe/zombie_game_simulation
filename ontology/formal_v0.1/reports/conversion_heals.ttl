@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zg: <urn:zombie-game:v0.1:> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <urn:zombie-game:example:conversion> ;
            sh:resultMessage "ConversionPreserves: Conversion preserves current life, stamina and position." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint zg:ConversionPreserves ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape zg:ConversionTransitionShape ;
            sh:value <urn:zombie-game:example:conversion> ] .

