@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zg: <urn:zombie-game:v0.1:> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <urn:zombie-game:example:state> ;
            sh:resultMessage "InventoryCapacity: Total portable stock, including reservations, fits capacity." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint zg:InventoryCapacity ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape zg:HumanStateShape ;
            sh:value <urn:zombie-game:example:state> ] .

