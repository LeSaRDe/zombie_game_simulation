                        owl:onProperty zg:hasRoleDefinition ] ) ] .

zg:ScreamerState a owl:Class ;
    rdfs:label "ScreamerState" ;
    rdfs:subClassOf zg:ZombieState ;
    owl:equivalentClass [ a owl:Class ;
