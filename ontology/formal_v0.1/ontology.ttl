zg:TimedEffect a owl:Class ;
    rdfs:label "TimedEffect" ;
    rdfs:subClassOf zg:Effect .

zg:TyrantState a owl:Class ;
    rdfs:label "TyrantState" ;
    rdfs:subClassOf zg:ZombieState ;
    owl:equivalentClass [ a owl:Class ;
