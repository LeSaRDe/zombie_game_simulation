@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zg: <urn:zombie-game:v0.1:> .

zg:ActionIntent a owl:Class ;
    rdfs:label "ActionIntent" .

zg:ActionOccurrence a owl:Class ;
    rdfs:label "ActionOccurrence" .

zg:ActiveZombieState a owl:Class ;
    rdfs:label "ActiveZombieState" ;
    rdfs:subClassOf zg:LivingState,
        zg:ZombieState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:AgentState [ a owl:Restriction ;
                        owl:hasValue zg:ACTIVE ;
                        owl:onProperty zg:status ] ) ] .

zg:Barricade a owl:Class ;
    rdfs:label "Barricade" ;
    rdfs:subClassOf zg:EnvironmentEntity .

zg:BarricadeState a owl:Class ;
    rdfs:label "BarricadeState" ;
    rdfs:subClassOf zg:EnvironmentState .

zg:BarrierDamageEffect a zg:EffectCategory .

zg:BarrierRepairEffect a zg:EffectCategory .

zg:BaselineScenarioDefinition a owl:Class ;
    rdfs:label "BaselineScenarioDefinition" ;
    rdfs:subClassOf zg:ScenarioDefinition .

zg:CombatActionDefinition a owl:Class ;
    rdfs:label "CombatActionDefinition" ;
    rdfs:subClassOf zg:ActionDefinition ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:ActionDefinition [ a owl:Restriction ;
                        owl:hasValue zg:PhysicalDamageEffect ;
                        owl:onProperty zg:mayCause ] ) ] .

zg:CommunicationEffect a zg:EffectCategory .

zg:ConstructionEffect a zg:EffectCategory .

zg:ConversionTransition a owl:Class ;
    rdfs:label "ConversionTransition" ;
    rdfs:subClassOf zg:LifecycleTransition .

zg:Cooldown a owl:Class ;
    rdfs:label "Cooldown" .

zg:CureTransition a owl:Class ;
    rdfs:label "CureTransition" ;
    rdfs:subClassOf zg:LifecycleTransition .

zg:DashEffect a zg:EffectCategory .

zg:DeathTransition a owl:Class ;
    rdfs:label "DeathTransition" ;
    rdfs:subClassOf zg:LifecycleTransition .

zg:DecisionModel a owl:Class ;
    rdfs:label "DecisionModel" .

zg:DoctorState a owl:Class ;
    rdfs:label "DoctorState" ;
    rdfs:subClassOf zg:HumanState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:LivingState [ a owl:Restriction ;
                        owl:hasValue zg:DOCTOR ;
                        owl:onProperty zg:hasRoleDefinition ] ) ] .

zg:EngineerState a owl:Class ;
    rdfs:label "EngineerState" ;
    rdfs:subClassOf zg:HumanState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:LivingState [ a owl:Restriction ;
                        owl:hasValue zg:ENGINEER ;
                        owl:onProperty zg:hasRoleDefinition ] ) ] .

zg:Event a owl:Class ;
    rdfs:label "Event" .

zg:Gate a owl:Class ;
    rdfs:label "Gate" ;
    rdfs:subClassOf zg:EnvironmentEntity .

zg:GateClosingEffect a zg:EffectCategory .

zg:GateOpeningEffect a zg:EffectCategory .

zg:GateState a owl:Class ;
    rdfs:label "GateState" ;
    rdfs:subClassOf zg:EnvironmentState .

zg:GuardEffect a zg:EffectCategory .

zg:HealingActionDefinition a owl:Class ;
    rdfs:label "HealingActionDefinition" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:ActionDefinition [ a owl:Restriction ;
                        owl:hasValue zg:LifeRestorationEffect ;
                        owl:onProperty zg:mayCause ] ) ] .

zg:HealthyHumanState a owl:Class ;
    rdfs:label "HealthyHumanState" ;
    rdfs:subClassOf zg:HumanState,
        zg:LivingState ;
    owl:disjointWith zg:InfectedHumanState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:AgentState [ a owl:Restriction ;
                        owl:hasValue zg:HEALTHY ;
                        owl:onProperty zg:status ] ) ] .

zg:HumanRoleDefinition a owl:Class ;
    rdfs:label "HumanRoleDefinition" ;
    rdfs:subClassOf zg:RoleDefinition ;
    owl:disjointWith zg:ZombieRoleDefinition .

zg:HungerReductionEffect a zg:EffectCategory .

zg:InfectionCapableActionDefinition a owl:Class ;
    rdfs:label "InfectionCapableActionDefinition" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:ActionDefinition [ a owl:Restriction ;
                        owl:hasValue zg:InfectionOnsetEffect ;
                        owl:onProperty zg:mayCause ] ) ] .

zg:InfectionCureEffect a zg:EffectCategory .

zg:Intervention a owl:Class ;
    rdfs:label "Intervention" .

zg:Inventory a owl:Class ;
    rdfs:label "Inventory" .

zg:Measurement a owl:Class ;
    rdfs:label "Measurement" .

zg:MovementEffect a zg:EffectCategory .

