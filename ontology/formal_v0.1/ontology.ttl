zg:CANCELLED_BY_DEATH a zg:ActionResult .

zg:CANCELLED_BY_INTERVENTION a zg:ActionResult .

zg:CLOSED a zg:GateMode .

zg:CONVERTED a zg:EpisodeOutcome .

zg:CURED a zg:EpisodeOutcome .

zg:DeadState a owl:Class ;
    rdfs:label "DeadState" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty zg:life ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Nothing ;
            owl:onProperty zg:hasCapability ],
        [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty zg:activeRole ],
        zg:AgentState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:AgentState [ a owl:Restriction ;
                        owl:hasValue zg:DEAD ;
                        owl:onProperty zg:status ] ) ] .

zg:Effect a owl:Class ;
    rdfs:label "Effect" .

zg:FAILED_PRECONDITION a zg:ActionResult .

zg:FOOD a zg:ResourceType .

zg:HOST_DIED a zg:EpisodeOutcome .

zg:IDLE a zg:ActionStatus .

zg:IN_PROGRESS a zg:ActionResult .

zg:InfectedHumanState a owl:Class ;
    rdfs:label "InfectedHumanState" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty zg:activeEpisode ;
            owl:someValuesFrom zg:InfectionEpisode ],
        zg:HumanState,
        zg:LivingState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:AgentState [ a owl:Restriction ;
                        owl:hasValue zg:INFECTED ;
                        owl:onProperty zg:status ] ) ] .

zg:InfectionOnsetEffect a zg:EffectCategory .

zg:LifeRestorationEffect a zg:EffectCategory .

zg:MATERIAL a zg:ResourceType .

zg:MEDICAL_SUPPLY a zg:ResourceType .

zg:MISSED a zg:ActionResult .

zg:ModelAssignment a owl:Class ;
    rdfs:label "ModelAssignment" .

zg:ONGOING a zg:EpisodeOutcome .

zg:OPEN a zg:GateMode .

zg:PARTIAL_BLOCKED a zg:ActionResult .

zg:PhysicalDamageEffect a zg:EffectCategory .

zg:REJECTED a zg:ActionResult .

zg:Remains a owl:Class ;
    rdfs:label "Remains" ;
    rdfs:subClassOf zg:EnvironmentEntity .

zg:RoleAssignment a owl:Class ;
    rdfs:label "RoleAssignment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty zg:roleDefinition ;
            owl:someValuesFrom zg:RoleDefinition ] .

zg:SUCCEEDED a zg:ActionResult .

zg:ScenarioDefinition a owl:Class ;
    rdfs:label "ScenarioDefinition" .

zg:SimulationRun a owl:Class ;
    rdfs:label "SimulationRun" .

zg:World a owl:Class ;
    rdfs:label "World" .

zg:ZombieRoleDefinition a owl:Class ;
    rdfs:label "ZombieRoleDefinition" ;
    rdfs:subClassOf zg:RoleDefinition .

zg:activeEpisode a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range zg:InfectionEpisode .

zg:hasCapability a owl:ObjectProperty ;
    rdfs:range zg:Capability ;
    owl:propertyChainAxiom ( zg:hasTypeProfile zg:grants ),
        ( zg:hasRoleDefinition zg:grants ) .

zg:hasTypeProfile a owl:ObjectProperty ;
    rdfs:domain zg:LivingState ;
    rdfs:range zg:AgentType .

zg:inRun a owl:FunctionalProperty,
        owl:ObjectProperty .

zg:infectedAgent a owl:ObjectProperty .

zg:life a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

zg:ofAgent a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range zg:Agent .

zg:world a owl:FunctionalProperty,
        owl:ObjectProperty .

zg:ACTIVE a zg:Status .

zg:Capability a owl:Class ;
    rdfs:label "Capability" .

zg:DEAD a zg:Status .

zg:HEALTHY a zg:Status .

zg:Human a zg:AgentType .

zg:INFECTED a zg:Status .

zg:InfectionEpisode a owl:Class ;
    rdfs:label "InfectionEpisode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty zg:infectedAgent ;
            owl:someValuesFrom zg:Agent ] .

zg:Zombie a zg:AgentType .

zg:activeRole a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain zg:LivingState ;
    rdfs:range zg:RoleAssignment .

zg:biologicalType a owl:FunctionalProperty,
        owl:ObjectProperty .

zg:grants a owl:ObjectProperty ;
    rdfs:range zg:Capability .

zg:roleDefinition a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range zg:RoleDefinition .

zg:ActionStatus a owl:Class ;
    rdfs:label "ActionStatus" .

zg:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty zg:inRun ;
            owl:someValuesFrom zg:SimulationRun ] ;
    owl:disjointWith zg:AgentState,
        zg:Remains .

zg:AgentType a owl:Class ;
    rdfs:label "AgentType" .

zg:GateMode a owl:Class ;
    rdfs:label "GateMode" .

zg:LifecycleTransition a owl:Class ;
    rdfs:label "LifecycleTransition" .

zg:mayCause a owl:ObjectProperty .

zg:ActionDefinition a owl:Class ;
    rdfs:label "ActionDefinition" .

zg:EpisodeOutcome a owl:Class ;
    rdfs:label "EpisodeOutcome" .

zg:ResourceType a owl:Class ;
    rdfs:label "ResourceType" .

zg:RoleDefinition a owl:Class ;
    rdfs:label "RoleDefinition" .

zg:Status a owl:Class ;
    rdfs:label "Status" .

zg:status a owl:FunctionalProperty,
        owl:ObjectProperty .

zg:EnvironmentState a owl:Class ;
    rdfs:label "EnvironmentState" .

zg:EnvironmentEntity a owl:Class ;
    rdfs:label "EnvironmentEntity" .

zg:HumanState a owl:Class ;
    rdfs:label "HumanState" ;
    rdfs:subClassOf zg:AgentState ;
    owl:disjointWith zg:ZombieState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:AgentState [ a owl:Restriction ;
                        owl:hasValue zg:Human ;
                        owl:onProperty zg:biologicalType ] ) ] .

zg:ZombieState a owl:Class ;
    rdfs:label "ZombieState" ;
    rdfs:subClassOf zg:AgentState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( zg:AgentState [ a owl:Restriction ;
                        owl:hasValue zg:Zombie ;
                        owl:onProperty zg:biologicalType ] ) ] .

zg:hasRoleDefinition a owl:ObjectProperty ;
    owl:propertyChainAxiom ( zg:activeRole zg:roleDefinition ) .

zg:ActionResult a owl:Class ;
    rdfs:label "ActionResult" .

zg:AgentState a owl:Class ;
    rdfs:label "AgentState" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty zg:world ;
            owl:someValuesFrom zg:World ],
        [ a owl:Restriction ;
            owl:onProperty zg:ofAgent ;
            owl:someValuesFrom zg:Agent ] .

zg:LivingState a owl:Class ;
    rdfs:label "LivingState" ;
    rdfs:subClassOf zg:AgentState ;
    owl:disjointWith zg:DeadState .

zg:EffectCategory a owl:Class ;
    rdfs:label "EffectCategory" .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:cap_move zg:cap_wait zg:cap_rest zg:cap_signal zg:cap_melee zg:cap_pickup zg:cap_drop zg:cap_transfer zg:cap_eat zg:cap_first_aid zg:cap_open_gate zg:cap_close_gate zg:cap_claw zg:cap_bite zg:cap_feed zg:cap_smash zg:cap_treat_infection zg:cap_prophylaxis zg:cap_power_strike zg:cap_guard zg:cap_recon zg:cap_mark_target zg:cap_build_barricade zg:cap_repair_barrier zg:cap_rally zg:cap_demolish zg:cap_dash zg:cap_spit zg:cap_scream ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:HEALTHY zg:INFECTED zg:ACTIVE zg:DEAD ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:FOOD zg:MEDICAL_SUPPLY zg:MATERIAL zg:BIOMASS ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:OPEN zg:CLOSED zg:BREACHED ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:IDLE zg:BUSY zg:ACTION_DEAD ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:Human zg:Zombie ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:ONGOING zg:CURED zg:CONVERTED zg:HOST_DIED ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:SUCCEEDED zg:MISSED zg:FAILED_PRECONDITION zg:CANCELLED_BY_DEATH zg:CANCELLED_BY_CONVERSION zg:CANCELLED_BY_CONFLICT zg:CANCELLED_BY_INTERVENTION zg:PARTIAL_BLOCKED zg:IN_PROGRESS zg:REJECTED ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( zg:DOCTOR zg:WARRIOR zg:SCOUT zg:ENGINEER zg:TYRANT zg:RUNNER zg:SPITTER zg:SCREAMER ) .

