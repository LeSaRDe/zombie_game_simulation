    rdfs:label "ObstacleState" ;
    rdfs:subClassOf zg:EnvironmentState .

zg:Ontology a owl:Ontology ;
    owl:versionIRI zg:ontology-0.1.0 ;
    owl:versionInfo "0.1.0" ;
    zg:sourceText "Formalization of unchanged zombie_game_ontology_v0.1.md; data validation is a separate SHACL layer." .

