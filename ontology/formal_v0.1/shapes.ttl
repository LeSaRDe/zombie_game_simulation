zg:ReciprocalAttackExclusion a sh:SPARQLConstraint ;
    sh:message "ReciprocalAttackExclusion: Overlapping reciprocal attacks cannot both be valid resolved attempts, including misses." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition/zg:mayCause zg:PhysicalDamageEffect; zg:actionResult ?r; zg:actorStart/zg:ofAgent ?actor; zg:targetStart/zg:ofAgent ?target; zg:startTime ?s; zg:resolvedAt ?end. ?other a zg:ActionOccurrence; zg:actionDefinition/zg:mayCause zg:PhysicalDamageEffect; zg:actionResult ?orr; zg:actorStart/zg:ofAgent ?target; zg:targetStart/zg:ofAgent ?actor; zg:startTime ?os; zg:resolvedAt ?oe. FILTER(?other!=$this && ?r IN (zg:SUCCEEDED,zg:MISSED) && ?orr IN (zg:SUCCEEDED,zg:MISSED) && ?s<?oe && ?os<?end)
} """ .

zg:RectangleOrder a sh:SPARQLConstraint ;
