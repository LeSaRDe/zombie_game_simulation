zg:EpisodeClosure a sh:SPARQLConstraint ;
    sh:message "EpisodeClosure: Closed outcomes have end time/revision; ongoing episodes have neither." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:episodeOutcome ?o. FILTER((?o=zg:ONGOING && (EXISTS {$this zg:ended_at ?e} || EXISTS {$this zg:end_revision ?r})) || (?o!=zg:ONGOING && NOT EXISTS {$this zg:ended_at ?e; zg:end_revision ?r}))
} """ .

zg:EpisodeDeadline a sh:SPARQLConstraint ;
    sh:message "EpisodeDeadline: Deadline equals onset plus positive incubation duration." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:onset_at ?o; zg:incubation_duration ?d; zg:conversion_due_at ?t. FILTER(?t != ?o+?d)
} """ .

zg:EpisodeEndOrder a sh:SPARQLConstraint ;
    sh:message "EpisodeEndOrder: An episode cannot end before onset." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:onset_at ?o; zg:onset_revision ?r; zg:ended_at ?e; zg:end_revision ?v. FILTER(?e<?o || (?e=?o && ?v<?r))
} """ .

zg:EpisodeOwnership a sh:SPARQLConstraint ;
    sh:message "EpisodeOwnership: Active episode belongs to this agent and is active at this causal revision." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:ofAgent ?a; zg:atTime ?t; zg:revision ?r; zg:activeEpisode ?e. ?e zg:infectedAgent ?b; zg:onset_at ?on; zg:onset_revision ?orr; zg:conversion_due_at ?due. OPTIONAL {?e zg:ended_at ?end; zg:end_revision ?er} FILTER(?a!=?b || ?t<?on || (?t=?on && ?r<?orr) || ?t>?due || (BOUND(?end) && (?t>?end || (?t=?end && ?r>=?er))))
} """ .

