zg:NoCausalCycle a sh:SPARQLConstraint ;
    sh:message "NoCausalCycle: Event causal graph must be acyclic." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:cause+ $this.
} """ .

zg:NoResurrection a sh:SPARQLConstraint ;
    sh:message "NoResurrection: No recorded later state of a dead identity is alive or changes its type/location." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:life 0; zg:ofAgent ?a; zg:atTime ?t; zg:revision ?r; zg:biologicalType ?ty; zg:x ?x; zg:y ?y. ?later a zg:AgentState; zg:ofAgent ?a; zg:atTime ?u; zg:revision ?v; zg:life ?l; zg:biologicalType ?lt; zg:x ?lx; zg:y ?ly. FILTER((?u>?t || (?u=?t && ?v>?r)) && (?l!=0 || ?ty!=?lt || ?x!=?lx || ?y!=?ly))
} """ .

