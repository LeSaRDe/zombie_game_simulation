zg:AliveAssignments a sh:SPARQLConstraint ;
    sh:message "AliveAssignments: A living state has a model and its matching type capability profile." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:life ?l; zg:biologicalType ?t. FILTER(?l>0 && (NOT EXISTS {$this zg:activeModel ?m} || NOT EXISTS {$this zg:hasTypeProfile ?t}))
} """ .

zg:BarricadeStateIntegrity a sh:SPARQLConstraint ;
    sh:message "BarricadeStateIntegrity: Integrity cannot exceed its maximum." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:integrity ?i; zg:max_integrity ?m. FILTER(?i>?m)
} """ .

zg:BarricadeState_integrityShape sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:message "BarricadeState.integrity: required datatype, cardinality, range, or reference violated." ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path zg:integrity .

zg:BarricadeState_max_integrityShape sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:message "BarricadeState.max_integrity: required datatype, cardinality, range, or reference violated." ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:path zg:max_integrity .

zg:BiomassReservation a sh:SPARQLConstraint ;
    sh:message "BiomassReservation: Biomass reservations cannot exceed biomass." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:biomass ?b; zg:reserved_biomass ?r. FILTER(?r>?b)
} """ .

zg:ConversionDeadline a sh:SPARQLConstraint ;
    sh:message "ConversionDeadline: Conversion occurs exactly at its episode deadline and closes that episode as CONVERTED." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:episode ?e; zg:beforeState ?b; zg:afterState ?a. ?b zg:activeEpisode ?be. ?a zg:atTime ?t; zg:revision ?r. ?e zg:conversion_due_at ?due; zg:episodeOutcome ?out; zg:ended_at ?end; zg:end_revision ?er. FILTER(?be!=?e || ?t!=?due || ?out!=zg:CONVERTED || ?end!=?t || ?er!=?r)
} """ .

zg:ConversionPreserves a sh:SPARQLConstraint ;
    sh:message "ConversionPreserves: Conversion preserves current life, stamina and position." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:beforeState ?b; zg:afterState ?a. ?b zg:life ?l; zg:stamina ?s; zg:x ?x; zg:y ?y. ?a zg:life ?m; zg:stamina ?t; zg:x ?u; zg:y ?v. FILTER(?l!=?m || ?s!=?t || ?x!=?u || ?y!=?v)
} """ .

zg:ConversionTransition_episodeShape sh:class zg:InfectionEpisode ;
    sh:maxCount 1 ;
    sh:message "ConversionTransition.episode: required datatype, cardinality, range, or reference violated." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path zg:episode .

zg:ConversionTypes a sh:SPARQLConstraint ;
    sh:message "ConversionTypes: Conversion changes living infected Human to active, role-free Zombie." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:beforeState ?b; zg:afterState ?a. ?b zg:biologicalType ?bt; zg:status ?bs; zg:life ?bl. ?a zg:biologicalType ?at; zg:status ?as. FILTER(?bt!=zg:Human || ?bs!=zg:INFECTED || ?bl<=0 || ?at!=zg:Zombie || ?as!=zg:ACTIVE || EXISTS {?a zg:activeRole ?r} || EXISTS {?a zg:inventory ?i})
} """ .

zg:Cooldown_forActionShape sh:class zg:ActionDefinition ;
    sh:maxCount 1 ;
    sh:message "Cooldown.forAction: required datatype, cardinality, range, or reference violated." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path zg:forAction .

zg:Cooldown_untilShape sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:message "Cooldown.until: required datatype, cardinality, range, or reference violated." ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path zg:until .

zg:CureEpisode a sh:SPARQLConstraint ;
    sh:message "CureEpisode: Cure closes the exact active episode before its deadline." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:episode ?e; zg:beforeState ?b; zg:afterState ?a; zg:triggeredBy ?act. ?b zg:activeEpisode ?old. ?a zg:atTime ?t; zg:revision ?r. ?e zg:conversion_due_at ?due; zg:episodeOutcome ?out; zg:ended_at ?end; zg:end_revision ?er. FILTER(?old!=?e || ?t>=?due || ?out!=zg:CURED || ?end!=?t || ?er!=?r || NOT EXISTS {?act zg:actionDefinition zg:action_treat_infection; zg:actionResult zg:SUCCEEDED; zg:targetBeforeEnd ?b; zg:targetAfterEnd ?a})
} """ .

zg:CureStates a sh:SPARQLConstraint ;
    sh:message "CureStates: Cure changes INFECTED to HEALTHY while preserving type and life." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:beforeState ?b; zg:afterState ?a. ?b zg:status ?bs; zg:biologicalType ?bt; zg:life ?l. ?a zg:status ?as; zg:biologicalType ?at; zg:life ?v. FILTER(?bs!=zg:INFECTED || ?as!=zg:HEALTHY || ?bt!=zg:Human || ?at!=zg:Human || ?l<=0 || ?v!=?l)
} """ .

