    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:x ?x; zg:y ?y; zg:world ?w. ?w zg:length ?l; zg:width ?h. FILTER(?x<0 || ?y<0 || ?x>?l || ?y>?h)
} """ .

