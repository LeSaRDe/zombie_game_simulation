    sh:path zg:treatment_duration .

zg:DeadCleanup a sh:SPARQLConstraint ;
    sh:message "DeadCleanup: Death clears active references, movement and sensing; death metadata is present." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:life 0. FILTER(EXISTS {$this zg:activeRole ?r} || EXISTS {$this zg:activeModel ?m} || EXISTS {$this zg:activeAction ?a} || EXISTS {$this zg:activeEpisode ?e} || EXISTS {$this zg:hasTypeProfile ?t} || EXISTS {$this zg:effect ?f} || EXISTS {$this zg:cooldownRecord ?c} || EXISTS {$this zg:speed ?s FILTER(?s!=0)} || EXISTS {$this zg:sense_r ?r FILTER(?r!=0)} || NOT EXISTS {$this zg:death_at ?d; zg:deathCause ?c})
} """ .

zg:DeadInventory a sh:SPARQLConstraint ;
    sh:message "DeadInventory: A dead human has an empty inventory." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:life 0; zg:inventory/zg:stock/zg:quantity ?q. FILTER(?q!=0)
} """ .

zg:DeathTypes a sh:SPARQLConstraint ;
    sh:message "DeathTypes: Death changes positive life to zero and preserves type and location." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:beforeState ?b; zg:afterState ?a. ?b zg:life ?l; zg:biologicalType ?ty; zg:x ?x; zg:y ?y. ?a zg:life ?v; zg:status ?s; zg:biologicalType ?at; zg:x ?u; zg:y ?w. FILTER(?l<=0 || ?v!=0 || ?s!=zg:DEAD || ?ty!=?at || ?x!=?u || ?y!=?w)
} """ .

