zg:StarvationTimers a sh:SPARQLConstraint ;
    sh:message "StarvationTimers: Living hunger-100 states require starvation timers; other states clear them." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:hunger ?h; zg:life ?l. FILTER((?h=100 && ?l>0 && NOT EXISTS {$this zg:starvation_started_at ?s; zg:next_starvation_damage_at ?n}) || ((?h<100 || ?l=0) && (EXISTS {$this zg:starvation_started_at ?s} || EXISTS {$this zg:next_starvation_damage_at ?n})))
} """ .

zg:StateIdentityRevision a sh:SPARQLConstraint ;
    sh:message "StateIdentityRevision: One state per agent, time, and causal revision." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:ofAgent ?a; zg:atTime ?t; zg:revision ?r. ?other a zg:AgentState; zg:ofAgent ?a; zg:atTime ?t; zg:revision ?r. FILTER(?other!=$this)
} """ .

zg:StateStatus a sh:SPARQLConstraint ;
    sh:message "StateStatus: Type/status/life and active episode must agree." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:biologicalType ?t; zg:status ?s; zg:life ?l. FILTER((?l=0 && ?s!=zg:DEAD) || (?l>0 && ?s=zg:DEAD) || (?t=zg:Human && ?s=zg:ACTIVE) || (?t=zg:Zombie && ?s NOT IN (zg:ACTIVE,zg:DEAD)) || (?s=zg:INFECTED && NOT EXISTS {$this zg:activeEpisode ?e}) || (?s!=zg:INFECTED && EXISTS {$this zg:activeEpisode ?e}))
} """ .

zg:StateTypeFields a sh:SPARQLConstraint ;
    sh:message "StateTypeFields: Applicable type-specific fields and explicit state classification are required." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:biologicalType ?t. FILTER((?t=zg:Human && NOT EXISTS {$this a zg:HumanState; zg:hunger ?h; zg:inventory ?i}) || (?t=zg:Zombie && NOT EXISTS {$this a zg:ZombieState; zg:virulence ?v}) || (?t=zg:Zombie && EXISTS {$this zg:inventory ?i}) || (?t=zg:Zombie && EXISTS {$this zg:hunger ?h}))
} """ .

zg:StateWorld a sh:SPARQLConstraint ;
    sh:message "StateWorld: State world matches its agent run." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:ofAgent/zg:inRun/zg:world ?w; zg:world ?v. FILTER(?w!=?v)
} """ .

