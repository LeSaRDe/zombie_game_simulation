    sh:message "RoleCompatibility: Active role belongs to this agent and supports this biological type." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:ofAgent ?a; zg:biologicalType ?t; zg:activeRole ?r. ?r zg:ofAgent ?b; zg:roleDefinition/zg:compatibleType ?rt. FILTER(?a!=?b || ?t!=?rt)
} """ .

