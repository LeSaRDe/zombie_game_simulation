@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zg: <urn:zombie-game:v0.1:> .

zg:ActionDefinitionShape a sh:NodeShape ;
    sh:property zg:ActionDefinition_capabilityShape,
        zg:ActionDefinition_cooldownShape,
        zg:ActionDefinition_duration_maxShape,
        zg:ActionDefinition_duration_minShape,
        zg:ActionDefinition_mayCauseShape,
        zg:ActionDefinition_reachShape,
        zg:ActionDefinition_stamina_costShape,
        zg:ActionDefinition_target_kindShape ;
    sh:sparql zg:DurationBounds ;
    sh:targetClass zg:ActionDefinition .

zg:ActionIntentShape a sh:NodeShape ;
    sh:property zg:ActionIntent_actionDefinitionShape,
        zg:ActionIntent_actorShape,
        zg:ActionIntent_observesShape,
        zg:ActionIntent_proposedAtShape ;
    sh:targetClass zg:ActionIntent .

zg:ActionOccurrenceShape a sh:NodeShape ;
    sh:property zg:ActionOccurrence_actionDefinitionShape,
        zg:ActionOccurrence_actionResultShape,
        zg:ActionOccurrence_actorAfterEndShape,
        zg:ActionOccurrence_actorAfterStartShape,
        zg:ActionOccurrence_actorBeforeEndShape,
        zg:ActionOccurrence_actorStartShape,
