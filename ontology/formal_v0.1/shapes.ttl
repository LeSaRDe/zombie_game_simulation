SELECT $this WHERE {
$this zg:actionResult zg:MISSED; zg:actionDefinition ?d. FILTER(?d NOT IN (zg:action_melee,zg:action_claw,zg:action_bite,zg:action_power_strike,zg:action_spit))
} """ .

