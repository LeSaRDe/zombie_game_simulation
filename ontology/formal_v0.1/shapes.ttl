    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:start_at ?s; zg:end_at ?e. FILTER(?e<?s)
} """ .

