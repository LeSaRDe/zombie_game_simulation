        zg:ActionOccurrence_targetAfterEndShape,
        zg:ActionOccurrence_targetBeforeEndShape,
        zg:ActionOccurrence_targetEntityShape,
        zg:ActionOccurrence_targetStartShape ;
    sh:sparql zg:ActionAdmission,
        zg:ActionCapability,
        zg:ActionCooldown,
        zg:ActionDuration,
        zg:ActionRelease,
        zg:ActorEndIdentity,
        zg:ActorResolutionAlive,
        zg:ActorStartIdentity,
        zg:AdmissionCooldown,
        zg:AdmissionStamina,
        zg:AgentEndReach,
        zg:AgentStartReach,
        zg:IntentAgreement,
        zg:MissOnlyAttack,
        zg:OneActionAtATime,
        zg:ReciprocalAttackExclusion,
        zg:RequiredTargets,
        zg:ResultTiming,
        zg:TreatmentConsume,
        zg:TreatmentCureRecord,
        zg:TreatmentDeadline,
        zg:TreatmentEffect,
        zg:TreatmentFailureRelease,
        zg:TreatmentReserve,
        zg:TreatmentStartTarget,
        zg:TreatmentSupplyEvidence,
        zg:TreatmentTargetRecords ;
    sh:targetClass zg:ActionOccurrence .

