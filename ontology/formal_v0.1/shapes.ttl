zg:TransitionIdentity a sh:SPARQLConstraint ;
    sh:message "TransitionIdentity: Atomic lifecycle transitions preserve identity and time, and increase causal revision." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:beforeState ?b; zg:afterState ?a. ?b zg:ofAgent ?i; zg:atTime ?t; zg:revision ?r. ?a zg:ofAgent ?j; zg:atTime ?u; zg:revision ?s. FILTER(?i!=?j || ?t!=?u || ?s<=?r)
} """ .

zg:TreatmentConsume a sh:SPARQLConstraint ;
    sh:message "TreatmentConsume: Successful treatment consumes one reserved medical item." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:actionResult zg:SUCCEEDED; zg:actorBeforeEnd/zg:inventory/zg:stock ?b; zg:actorAfterEnd/zg:inventory/zg:stock ?a. ?b zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?q; zg:reserved ?r. ?a zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?v; zg:reserved ?s. FILTER(?r<1 || ?v!=?q-1 || ?s!=?r-1)
} """ .

zg:TreatmentCureRecord a sh:SPARQLConstraint ;
    sh:message "TreatmentCureRecord: Successful treatment includes its linked cure transition and closed episode." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:actionResult zg:SUCCEEDED. FILTER(NOT EXISTS {?c a zg:CureTransition; zg:triggeredBy $this})
} """ .

zg:TreatmentDeadline a sh:SPARQLConstraint ;
    sh:message "TreatmentDeadline: Successful treatment completes strictly before the episode deadline." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:actionResult zg:SUCCEEDED; zg:resolvedAt ?t; zg:targetBeforeEnd/zg:activeEpisode/zg:conversion_due_at ?due. FILTER(?t>=?due)
} """ .

zg:TreatmentEffect a sh:SPARQLConstraint ;
    sh:message "TreatmentEffect: Successful treatment ends infection without changing target life or position." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:actionResult zg:SUCCEEDED; zg:targetBeforeEnd ?b; zg:targetAfterEnd ?a. ?b zg:ofAgent ?i; zg:life ?l; zg:x ?x; zg:y ?y; zg:status ?old. ?a zg:ofAgent ?j; zg:life ?v; zg:x ?u; zg:y ?w; zg:status ?new; zg:biologicalType ?ty. FILTER(?i!=?j || ?old!=zg:INFECTED || ?new!=zg:HEALTHY || ?ty!=zg:Human || ?l!=?v || ?x!=?u || ?y!=?w || EXISTS {?a zg:activeEpisode ?e})
} """ .

zg:TreatmentFailureRelease a sh:SPARQLConstraint ;
    sh:message "TreatmentFailureRelease: A target-precondition failure releases the medical reservation without consuming the item." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:actionResult zg:FAILED_PRECONDITION; zg:actorBeforeEnd/zg:inventory/zg:stock ?b; zg:actorAfterEnd/zg:inventory/zg:stock ?a. ?b zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?q; zg:reserved ?r. ?a zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?v; zg:reserved ?s. FILTER(?r<1 || ?v!=?q || ?s!=?r-1)
} """ .

zg:TreatmentReserve a sh:SPARQLConstraint ;
    sh:message "TreatmentReserve: Admission reserves one available medical item without consuming it." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:actorStart/zg:inventory/zg:stock ?b; zg:actorAfterStart/zg:inventory/zg:stock ?a. ?b zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?q; zg:reserved ?r. ?a zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?v; zg:reserved ?s. FILTER(?q-?r<1 || ?v!=?q || ?s!=?r+1)
} """ .

zg:TreatmentStartTarget a sh:SPARQLConstraint ;
    sh:message "TreatmentStartTarget: Treatment starts on a living infected human." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:targetStart ?s. ?s zg:status ?st; zg:biologicalType ?ty; zg:life ?l. FILTER(?st!=zg:INFECTED || ?ty!=zg:Human || ?l<=0)
} """ .

zg:TreatmentSupplyEvidence a sh:SPARQLConstraint ;
    sh:message "TreatmentSupplyEvidence: Treatment resource states must record medical stock at admission and resolution." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:actionResult ?r; zg:actorStart ?s; zg:actorAfterStart ?a. FILTER(NOT EXISTS {?s zg:inventory/zg:stock [zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?q; zg:reserved ?v]} || NOT EXISTS {?a zg:inventory/zg:stock [zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?q; zg:reserved ?v]} || (?r!=zg:IN_PROGRESS && (NOT EXISTS {$this zg:actorBeforeEnd/zg:inventory/zg:stock [zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?q; zg:reserved ?v]} || NOT EXISTS {$this zg:actorAfterEnd/zg:inventory/zg:stock [zg:resourceType zg:MEDICAL_SUPPLY; zg:quantity ?q; zg:reserved ?v]})))
} """ .

zg:TreatmentTargetRecords a sh:SPARQLConstraint ;
    sh:message "TreatmentTargetRecords: Treatment requires start target; successful treatment also requires resolution target records." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition zg:action_treat_infection; zg:actionResult ?r. FILTER(NOT EXISTS {$this zg:targetStart ?s} || (?r=zg:SUCCEEDED && NOT EXISTS {$this zg:targetBeforeEnd ?b; zg:targetAfterEnd ?a}))
} """ .

zg:UniqueAgentID a sh:SPARQLConstraint ;
    sh:message "UniqueAgentID: Agent ID is unique within a run." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:inRun ?r; zg:agent_id ?id. ?other a zg:Agent; zg:inRun ?r; zg:agent_id ?id. FILTER(?other != $this)
} """ .

zg:UniqueInventoryResource a sh:SPARQLConstraint ;
    sh:message "UniqueInventoryResource: One stock per portable resource type in each inventory." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:stock ?a,?b. ?a zg:resourceType ?t. ?b zg:resourceType ?t. FILTER(?a!=?b)
} """ .

