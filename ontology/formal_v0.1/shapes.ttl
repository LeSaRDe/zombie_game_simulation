zg:ActionDuration a sh:SPARQLConstraint ;
    sh:message "ActionDuration: Planned duration is within the declared baseline bounds." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:startTime ?t; zg:plannedEnd ?e; zg:actionDefinition ?a. ?a zg:duration_min ?lo; zg:duration_max ?hi. FILTER(?e-?t<?lo || ?e-?t>?hi)
} """ .

