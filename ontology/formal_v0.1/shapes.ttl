zg:RoleFieldApplicability a sh:SPARQLConstraint ;
    sh:message "RoleFieldApplicability: Spitter charges exist only for current Spitters and stay within their declared maximum." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
OPTIONAL {$this zg:activeRole/zg:roleDefinition ?role} OPTIONAL {$this zg:spit_charges ?q} FILTER((?role=zg:SPITTER && !BOUND(?q)) || (BOUND(?q) && (!BOUND(?role) || ?role!=zg:SPITTER)) || (BOUND(?q) && EXISTS {zg:SPITTER zg:max_spit_charges ?max FILTER(?q>?max)}))
} """ .

zg:RoleOverrides a sh:SPARQLConstraint ;
    sh:message "RoleOverrides: Current common/type profile fields agree with the active role overrides." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:activeRole/zg:roleDefinition ?role. ?role ?p ?value. FILTER(?p IN (zg:base_speed,zg:base_sense_r,zg:base_damage_resistance,zg:medical_skill,zg:combat_skill,zg:melee_damage,zg:carry_capacity,zg:claw_damage,zg:attack_skill)) FILTER(NOT EXISTS {$this ?p ?value})
} """ .

