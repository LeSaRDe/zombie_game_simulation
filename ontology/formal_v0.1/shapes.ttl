zg:ResultTiming a sh:SPARQLConstraint ;
    sh:message "ResultTiming: Ongoing occurrences lack final state/time; resolved attempts include them and do not end before admission." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionResult ?r; zg:startTime ?s; zg:plannedEnd ?p. OPTIONAL {$this zg:resolvedAt ?e} FILTER((?r=zg:IN_PROGRESS && (BOUND(?e) || EXISTS {$this zg:actorAfterEnd ?a})) || (?r!=zg:IN_PROGRESS && (!BOUND(?e) || NOT EXISTS {$this zg:actorBeforeEnd ?b; zg:actorAfterEnd ?a})) || (BOUND(?e) && ?e<?s) || (?r IN (zg:SUCCEEDED,zg:MISSED) && ?e!=?p))
} """ .

