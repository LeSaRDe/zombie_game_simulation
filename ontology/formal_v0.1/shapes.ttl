zg:OneActionAtATime a sh:SPARQLConstraint ;
    sh:message "OneActionAtATime: Recorded action intervals for the same actor do not overlap." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actorStart/zg:ofAgent ?actor; zg:startTime ?s; zg:plannedEnd ?p. OPTIONAL {$this zg:resolvedAt ?r} BIND(COALESCE(?r,?p) AS ?end) ?other a zg:ActionOccurrence; zg:actorStart/zg:ofAgent ?actor; zg:startTime ?os; zg:plannedEnd ?op. OPTIONAL {?other zg:resolvedAt ?orr} BIND(COALESCE(?orr,?op) AS ?oe) FILTER(?other!=$this && ?s<?oe && ?os<?end)
} """ .

