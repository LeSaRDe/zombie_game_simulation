    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:xmin ?a; zg:xmax ?b; zg:ymin ?c; zg:ymax ?d. FILTER(?a>=?b || ?c>=?d)
} """ .

