zg:InfectionProgress a sh:SPARQLConstraint ;
    sh:message "InfectionProgress: Progress agrees with the referenced clock; it is zero without an episode." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:infection_progress ?p; zg:atTime ?t. OPTIONAL {$this zg:activeEpisode ?e. ?e zg:onset_at ?o; zg:incubation_duration ?d} FILTER((!BOUND(?e) && ?p!=0) || (BOUND(?e) && ABS(?p - ((?t-?o)/?d))>0.000000001))
} """ .

zg:IntentAgreement a sh:SPARQLConstraint ;
    sh:message "IntentAgreement: The action realizes the same actor/action definition as its intent and cannot start before proposal." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:realizes ?i; zg:actorStart/zg:ofAgent ?a; zg:actionDefinition ?d; zg:startTime ?s. ?i zg:actor ?b; zg:actionDefinition ?e; zg:proposedAt ?p; zg:observes/zg:observer ?o. FILTER(?a!=?b || ?d!=?e || ?s<?p || ?a!=?o)
} """ .

zg:InventoryCapacity a sh:SPARQLConstraint ;
    sh:message "InventoryCapacity: Total portable stock, including reservations, fits capacity." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:inventory/zg:stock/zg:quantity ?q; zg:carry_capacity ?c.
} GROUP BY $this HAVING(SUM(?q)>MAX(?c))""" .

