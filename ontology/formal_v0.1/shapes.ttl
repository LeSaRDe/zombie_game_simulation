    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:observer ?a; zg:selfState ?s; zg:atTime ?t; zg:revision ?r. ?s zg:ofAgent ?b; zg:atTime ?u; zg:revision ?v. FILTER(?a!=?b || ?t!=?u || ?r!=?v)
} """ .

