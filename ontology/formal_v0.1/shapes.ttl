zg:ActionAdmission a sh:SPARQLConstraint ;
    sh:message "ActionAdmission: Actor is alive and idle at admission, with enough flat stamina." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actorStart ?s; zg:actionDefinition ?d. ?s zg:life ?l; zg:actionStatus ?as; zg:stamina ?st. ?d zg:stamina_cost ?cost. FILTER(?l<=0 || ?as!=zg:IDLE || ?st<?cost)
} """ .

zg:ActionCapability a sh:SPARQLConstraint ;
    sh:message "ActionCapability: An explicit applicable type or role grants the required capability." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actorStart ?s; zg:actionDefinition/zg:capability ?cap. FILTER(NOT EXISTS {?s zg:hasTypeProfile/zg:grants ?cap} && NOT EXISTS {?s zg:activeRole/zg:roleDefinition/zg:grants ?cap})
} """ .

zg:ActionCooldown a sh:SPARQLConstraint ;
    sh:message "ActionCooldown: A completed attempt records its cooldown unless actor death/conversion retires it." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionResult ?r; zg:actionDefinition ?d; zg:resolvedAt ?t; zg:actorStart/zg:biologicalType ?old; zg:actorAfterEnd ?s. ?d zg:cooldown ?cd. ?s zg:life ?l; zg:biologicalType ?new. FILTER(?r!=zg:IN_PROGRESS && ?l>0 && ?old=?new && ?cd>0) FILTER(NOT EXISTS {?s zg:cooldownRecord [zg:forAction ?d; zg:until ?u] FILTER(?u=?t+?cd)})
} """ .

zg:ActionDefinition_capabilityShape sh:class zg:Capability ;
    sh:maxCount 1 ;
    sh:message "ActionDefinition.capability: required datatype, cardinality, range, or reference violated." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path zg:capability .

zg:ActionDefinition_cooldownShape sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:message "ActionDefinition.cooldown: required datatype, cardinality, range, or reference violated." ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path zg:cooldown .

zg:ActionDefinition_duration_maxShape sh:datatype xsd:decimal ;
