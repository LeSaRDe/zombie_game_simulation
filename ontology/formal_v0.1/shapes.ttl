    sh:maxCount 1 ;
    sh:message "ActionOccurrence.targetEntity: required datatype, cardinality, range, or reference violated." ;
    sh:nodeKind sh:IRI ;
    sh:path zg:targetEntity .

zg:ActionOccurrence_targetStartShape sh:class zg:AgentState ;
    sh:maxCount 1 ;
    sh:message "ActionOccurrence.targetStart: required datatype, cardinality, range, or reference violated." ;
    sh:nodeKind sh:IRI ;
    sh:path zg:targetStart .

zg:ActionRelease a sh:SPARQLConstraint ;
    sh:message "ActionRelease: A resolved action is not still active in its immediate actor post-state." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionResult ?r; zg:actorAfterEnd ?s. FILTER(?r!=zg:IN_PROGRESS) ?s zg:activeAction ?a.
} """ .

zg:ActionState a sh:SPARQLConstraint ;
    sh:message "ActionState: BUSY iff a living state has an active action; dead action state is ACTION_DEAD." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:life ?l; zg:actionStatus ?s. FILTER((?l=0 && ?s!=zg:ACTION_DEAD) || (?l>0 && ?s=zg:ACTION_DEAD) || (?s=zg:BUSY && NOT EXISTS {$this zg:activeAction ?a}) || (?s!=zg:BUSY && EXISTS {$this zg:activeAction ?a}))
} """ .

zg:ActorEndIdentity a sh:SPARQLConstraint ;
    sh:message "ActorEndIdentity: Resolution records refer to the same actor/time and increasing revision." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actorStart/zg:ofAgent ?x; zg:actorBeforeEnd ?b; zg:actorAfterEnd ?a; zg:resolvedAt ?t. ?b zg:ofAgent ?y; zg:atTime ?bt; zg:revision ?br. ?a zg:ofAgent ?z; zg:atTime ?at; zg:revision ?ar. FILTER(?x!=?y || ?x!=?z || ?bt!=?t || ?at!=?t || ?ar<=?br)
} """ .

zg:ActorResolutionAlive a sh:SPARQLConstraint ;
    sh:message "ActorResolutionAlive: Successful or missed actions require a living actor at resolution." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionResult ?r; zg:actorBeforeEnd/zg:life ?l. FILTER(?r IN (zg:SUCCEEDED,zg:MISSED) && ?l<=0)
} """ .

zg:ActorStartIdentity a sh:SPARQLConstraint ;
    sh:message "ActorStartIdentity: Admission state records refer to the same actor/time, with increasing revision and the action becoming active." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actorStart ?b; zg:actorAfterStart ?a; zg:startTime ?t. ?b zg:ofAgent ?x; zg:atTime ?bt; zg:revision ?br. ?a zg:ofAgent ?y; zg:atTime ?at; zg:revision ?ar. FILTER(?x!=?y || ?bt!=?t || ?at!=?t || ?ar<=?br || NOT EXISTS {?a zg:activeAction $this; zg:actionStatus zg:BUSY})
} """ .

zg:AdmissionCooldown a sh:SPARQLConstraint ;
    sh:message "AdmissionCooldown: The action is not admitted during its cooldown." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:startTime ?t; zg:actionDefinition ?d; zg:actorStart/zg:cooldownRecord ?c. ?c zg:forAction ?d; zg:until ?u. FILTER(?t<?u)
} """ .

zg:AdmissionStamina a sh:SPARQLConstraint ;
    sh:message "AdmissionStamina: Flat stamina is paid exactly once at admission." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actorStart ?b; zg:actorAfterStart ?a; zg:actionDefinition/zg:stamina_cost ?cost. ?b zg:stamina ?s. ?a zg:stamina ?v. FILTER(?v!=?s-?cost)
} """ .

zg:AgentEndReach a sh:SPARQLConstraint ;
    sh:message "AgentEndReach: Successful/missed agent interactions must remain within reach." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionResult ?result; zg:actorBeforeEnd ?a; zg:targetBeforeEnd ?b; zg:actionDefinition/zg:reach ?r. FILTER(?result IN (zg:SUCCEEDED,zg:MISSED)) ?a zg:x ?x; zg:y ?y. ?b zg:x ?u; zg:y ?v. FILTER((?x-?u)*(?x-?u)+(?y-?v)*(?y-?v)>?r*?r)
} """ .

zg:AgentStartReach a sh:SPARQLConstraint ;
    sh:message "AgentStartReach: Agent-target interaction must be within declared reach at admission." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actorStart ?a; zg:targetStart ?b; zg:actionDefinition/zg:reach ?r. ?a zg:x ?x; zg:y ?y. ?b zg:x ?u; zg:y ?v. FILTER((?x-?u)*(?x-?u)+(?y-?v)*(?y-?v)>?r*?r)
} """ .

