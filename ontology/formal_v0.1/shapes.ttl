zg:RequiredTargets a sh:SPARQLConstraint ;
    sh:message "RequiredTargets: Agent/environment/footprint actions carry the relevant target record." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:actionDefinition/zg:target_kind ?k. FILTER((?k="Agent" && NOT EXISTS {$this zg:targetStart ?s}) || (?k="Environment" && NOT EXISTS {$this zg:targetEntity ?e}) || (?k="Footprint" && NOT EXISTS {$this zg:footprint ?r}))
} """ .

zg:ReservationBound a sh:SPARQLConstraint ;
    sh:message "ReservationBound: Reserved quantity cannot exceed total quantity." ;
    sh:select """PREFIX zg: <urn:zombie-game:v0.1:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this zg:quantity ?q; zg:reserved ?r. FILTER(?r>?q)
} """ .

zg:ResourceStock_holderShape sh:maxCount 1 ;
    sh:message "A resource stock has exactly one inventory or stockpile-state holder." ;
    sh:minCount 1 ;
    sh:or ( [ sh:class zg:Inventory ] [ sh:class zg:StockpileState ] ) ;
    sh:path [ sh:inversePath zg:stock ] .

