@prefix ex: <urn:zombie-game:example:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zg: <urn:zombie-game:v0.1:> .

ex:duplicate_Human_model a zg:ModelAssignment ;
    zg:modelDefinition ex:model ;
    zg:ofAgent ex:duplicate ;
    zg:start_at 0.0 .

ex:duplicate_state a zg:AgentState,
        zg:HumanState ;
    zg:actionStatus zg:IDLE ;
    zg:activeModel ex:duplicate_Human_model ;
    zg:atTime 0.0 ;
    zg:base_damage_resistance 0.0 ;
    zg:base_sense_r 40.0 ;
    zg:base_speed 2.0 ;
    zg:biologicalType zg:Human ;
    zg:carry_capacity 10 ;
    zg:combat_skill 0.35 ;
    zg:damage_resistance 0.0 ;
    zg:hasTypeProfile zg:Human ;
    zg:hunger 20.0 ;
    zg:hunger_rate 0.05 ;
    zg:infection_progress 0.0 ;
    zg:infection_resistance 0.2 ;
    zg:infection_resistance_effective 0.2 ;
    zg:inventory ex:duplicate_state_inventory ;
    zg:lastEvent ex:init ;
    zg:life 100 ;
    zg:max_life 100 ;
    zg:max_stamina 100.0 ;
    zg:medical_skill 0.2 ;
    zg:melee_damage 16 ;
    zg:movement_cost 0.1 ;
    zg:ofAgent ex:duplicate ;
    zg:rest_rate 4.0 ;
    zg:revision 0 ;
    zg:sense_r 40.0 ;
    zg:speed 2.0 ;
    zg:stamina 100.0 ;
    zg:status zg:HEALTHY ;
    zg:world ex:world ;
    zg:x 10.0 ;
    zg:y 10.0 .

ex:duplicate_state_FOOD a zg:ResourceStock ;
    zg:quantity 0 ;
    zg:reserved 0 ;
    zg:resourceType zg:FOOD .

ex:duplicate_state_MATERIAL a zg:ResourceStock ;
    zg:quantity 0 ;
    zg:reserved 0 ;
    zg:resourceType zg:MATERIAL .

ex:duplicate_state_MEDICAL_SUPPLY a zg:ResourceStock ;
    zg:quantity 0 ;
    zg:reserved 0 ;
    zg:resourceType zg:MEDICAL_SUPPLY .

ex:duplicate_state_inventory a zg:Inventory ;
    zg:stock ex:duplicate_state_FOOD,
        ex:duplicate_state_MATERIAL,
        ex:duplicate_state_MEDICAL_SUPPLY .

ex:person_Human_model a zg:ModelAssignment ;
    zg:modelDefinition ex:model ;
    zg:ofAgent ex:person ;
    zg:start_at 0.0 .

ex:scenario a zg:ScenarioDefinition .

ex:state a zg:AgentState,
        zg:HumanState ;
    zg:actionStatus zg:IDLE ;
    zg:activeModel ex:person_Human_model ;
    zg:atTime 0.0 ;
    zg:base_damage_resistance 0.0 ;
    zg:base_sense_r 40.0 ;
    zg:base_speed 2.0 ;
    zg:biologicalType zg:Human ;
    zg:carry_capacity 10 ;
    zg:combat_skill 0.35 ;
    zg:damage_resistance 0.0 ;
    zg:hasTypeProfile zg:Human ;
    zg:hunger 20.0 ;
    zg:hunger_rate 0.05 ;
    zg:infection_progress 0.0 ;
    zg:infection_resistance 0.2 ;
    zg:infection_resistance_effective 0.2 ;
    zg:inventory ex:state_inventory ;
    zg:lastEvent ex:init ;
    zg:life 100 ;
    zg:max_life 100 ;
    zg:max_stamina 100.0 ;
    zg:medical_skill 0.2 ;
    zg:melee_damage 16 ;
    zg:movement_cost 0.1 ;
    zg:ofAgent ex:person ;
    zg:rest_rate 4.0 ;
    zg:revision 0 ;
    zg:sense_r 40.0 ;
    zg:speed 2.0 ;
    zg:stamina 100.0 ;
    zg:status zg:HEALTHY ;
    zg:world ex:world ;
    zg:x 10.0 ;
    zg:y 10.0 .

ex:state_FOOD a zg:ResourceStock ;
    zg:quantity 0 ;
    zg:reserved 0 ;
    zg:resourceType zg:FOOD .

ex:state_MATERIAL a zg:ResourceStock ;
    zg:quantity 0 ;
    zg:reserved 0 ;
    zg:resourceType zg:MATERIAL .

ex:state_MEDICAL_SUPPLY a zg:ResourceStock ;
    zg:quantity 0 ;
    zg:reserved 0 ;
    zg:resourceType zg:MEDICAL_SUPPLY .

ex:state_inventory a zg:Inventory ;
    zg:stock ex:state_FOOD,
        ex:state_MATERIAL,
        ex:state_MEDICAL_SUPPLY .

ex:duplicate a zg:Agent ;
    zg:agent_id 1 ;
    zg:created_at 0.0 ;
    zg:hasState ex:duplicate_state ;
    zg:inRun ex:run .

ex:init a zg:Event ;
    zg:atTime 0.0 ;
    zg:revision 0 .

ex:model a zg:DecisionModel ;
    zg:model_id "fixture-model" ;
    zg:model_version "1" .

ex:person a zg:Agent ;
    zg:agent_id 1 ;
    zg:created_at 0.0 ;
    zg:hasState ex:state ;
    zg:inRun ex:run .

ex:run a zg:SimulationRun ;
    zg:scenario ex:scenario ;
    zg:world ex:world .

ex:world a zg:World ;
    zg:length 1000.0 ;
    zg:width 1000.0 .

