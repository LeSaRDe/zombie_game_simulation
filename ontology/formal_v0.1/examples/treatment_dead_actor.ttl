@prefix ex: <urn:zombie-game:example:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zg: <urn:zombie-game:v0.1:> .

ex:cure a zg:CureTransition,
        zg:LifecycleTransition ;
    zg:afterState ex:patient_post_end ;
    zg:beforeState ex:patient_pre_end ;
    zg:episode ex:episode ;
    zg:triggeredBy ex:treatment .

ex:doctor_admitted_FOOD a zg:ResourceStock ;
    zg:quantity 0 ;
    zg:reserved 0 ;
    zg:resourceType zg:FOOD .

ex:doctor_admitted_MATERIAL a zg:ResourceStock ;
    zg:quantity 0 ;
    zg:reserved 0 ;
    zg:resourceType zg:MATERIAL .

ex:doctor_admitted_MEDICAL_SUPPLY a zg:ResourceStock ;
    zg:quantity 2 ;
    zg:reserved 1 ;
    zg:resourceType zg:MEDICAL_SUPPLY .

ex:doctor_admitted_inventory a zg:Inventory ;
    zg:stock ex:doctor_admitted_FOOD,
        ex:doctor_admitted_MATERIAL,
        ex:doctor_admitted_MEDICAL_SUPPLY .

