ex:treatment a zg:ActionOccurrence ;
    zg:actionDefinition zg:action_treat_infection ;
    zg:actionResult zg:SUCCEEDED ;
    zg:actorAfterEnd ex:doctor_post_end ;
    zg:actorAfterStart ex:doctor_admitted ;
    zg:actorBeforeEnd ex:doctor_pre_end ;
    zg:actorStart ex:doctor_start ;
    zg:plannedEnd 104.0 ;
    zg:realizes ex:intent ;
    zg:resolvedAt 104.0 ;
    zg:startTime 100.0 ;
    zg:targetAfterEnd ex:patient_post_end ;
    zg:targetBeforeEnd ex:patient_pre_end ;
    zg:targetStart ex:patient_start .

ex:doctor_DOCTOR_role a zg:RoleAssignment ;
    zg:ofAgent ex:doctor ;
    zg:roleDefinition zg:DOCTOR ;
    zg:start_at 0.0 .

ex:doctor_Human_model a zg:ModelAssignment ;
    zg:modelDefinition ex:model ;
    zg:ofAgent ex:doctor ;
    zg:start_at 0.0 .

ex:patient a zg:Agent ;
    zg:agent_id 2 ;
    zg:created_at 0.0 ;
    zg:hasState ex:patient_post_end,
        ex:patient_pre_end,
        ex:patient_start ;
    zg:inRun ex:run .

ex:doctor a zg:Agent ;
    zg:agent_id 1 ;
    zg:created_at 0.0 ;
    zg:hasState ex:doctor_admitted,
        ex:doctor_post_end,
        ex:doctor_pre_end,
        ex:doctor_start ;
    zg:inRun ex:run .

ex:init a zg:Event ;
    zg:atTime 0.0 ;
    zg:revision 0 .

ex:world a zg:World ;
    zg:length 1000.0 ;
    zg:width 1000.0 .

