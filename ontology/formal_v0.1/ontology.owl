  <rdf:Description rdf:about="urn:zombie-game:v0.1:action_dash">
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:duration_min>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:duration_max>
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.0</zg:cooldown>
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_dash"/>
    <rdfs:label>dash</rdfs:label>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:MovementEffect"/>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:DashEffect"/>
    <zg:sourceText>| `dash` | A planned continuous path. Duration exactly `dash_duration` (1 s); flat 12 stamina plus distance × movement_cost; cooldown 8 s. During this action, speed limit is base speed × `dash_multiplier` (4.8 m/s at baseline). All movement boundary/obstacle rules apply. The multiplier ends with the action. No extra attack or damage occurs at its destination. |</zg:sourceText>
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0</zg:stamina_cost>
    <zg:target_kind>Path</zg:target_kind>
  </rdf:Description>
