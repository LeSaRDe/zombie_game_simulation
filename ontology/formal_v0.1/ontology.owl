  <rdf:Description rdf:about="urn:zombie-game:v0.1:action_feed">
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</zg:duration_min>
    <rdfs:label>feed</rdfs:label>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</zg:duration_max>
    <zg:sourceText>| `feed` | Remains within 1.5 m, biomass &gt;= 1 | 3 s | 0 / 1 s | Reserve and consume exactly 1 biomass. Restore `feed_healing` life and `feed_energy` stamina, each capped at its maximum. Requires life &lt; 100 or stamina &lt; 100 at admission and resolution. Feeding never affects the dead source agent. |</zg:sourceText>
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</zg:stamina_cost>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_feed"/>
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:cooldown>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:StaminaRestorationEffect"/>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:LifeRestorationEffect"/>
    <zg:target_kind>Environment</zg:target_kind>
    <zg:reach rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:reach>
  </rdf:Description>
