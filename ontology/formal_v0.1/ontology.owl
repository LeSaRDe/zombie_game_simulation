  <rdf:Description rdf:about="urn:zombie-game:v0.1:action_power_strike">
    <zg:target_kind>Agent</zg:target_kind>
    <zg:sourceText>| `power_strike` | Living opponent within 1.5 m. Duration 1.5 s; 15 stamina; cooldown 6 s. Human melee hit formula; raw damage `strike_damage` (34). Apply ordinary physical resistance and death rules. |</zg:sourceText>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:PhysicalDamageEffect"/>
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</zg:stamina_cost>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_power_strike"/>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:duration_max>
    <zg:reach rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:reach>
    <rdfs:label>power_strike</rdfs:label>
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.0</zg:cooldown>
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:duration_min>
  </rdf:Description>
  <rdf:Description rdf:about="urn:zombie-game:v0.1:action_melee">
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.0</zg:stamina_cost>
    <zg:sourceText>| `melee` | Living opponent within 1.5 m | 1 s | 6 / 1 s | Draw hit probability `clip(0.50 + 0.45 × combat_skill,0,1)`. On hit, apply `human.melee_damage` through physical damage resistance. |</zg:sourceText>
    <zg:target_kind>Agent</zg:target_kind>
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:duration_min>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:duration_max>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:cooldown>
    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_melee"/>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:PhysicalDamageEffect"/>
    <rdfs:label>melee</rdfs:label>
    <zg:reach rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:reach>
  </rdf:Description>
