    <rdf:rest rdf:nodeID="nc4382c36279b4f628c7ca9aee3940539b126"/>
    <rdf:first rdf:resource="urn:zombie-game:v0.1:OPEN"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:zombie-game:v0.1:action_bite">
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:InfectionOnsetEffect"/>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:PhysicalDamageEffect"/>
    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_bite"/>
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:duration_min>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:duration_max>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</zg:stamina_cost>
    <zg:target_kind>Agent</zg:target_kind>
    <rdfs:label>bite</rdfs:label>
    <zg:sourceText>| `bite` | Living opponent within 1.5 m | 1.5 s | 10 / 2 s | Draw a hit. On hit, apply `zombie.bite_damage`; if the target survives and is HEALTHY Human, attempt infection with exposure potency `zombie.virulence`. A same-type target, when allowed, receives damage but cannot be infected. |</zg:sourceText>
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</zg:cooldown>
    <zg:reach rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:reach>
  </rdf:Description>
