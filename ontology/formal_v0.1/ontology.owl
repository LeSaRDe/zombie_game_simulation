  <rdf:Description rdf:about="urn:zombie-game:v0.1:action_first_aid">
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <rdfs:label>first_aid</rdfs:label>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:LifeRestorationEffect"/>
    <zg:reach rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:reach>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</zg:duration_max>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</zg:cooldown>
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</zg:duration_min>
    <zg:target_kind>Agent</zg:target_kind>
    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_first_aid"/>
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.0</zg:stamina_cost>
    <zg:sourceText>| `first_aid` | Self or living human within 1.5 m with life &lt; 100; 1 MEDICAL_SUPPLY | 3 s | 4 / 2 s | Restore `10 + round_int(20 × actor.medical_skill)` life, capped at 100. No effect on infection or hunger. |</zg:sourceText>
  </rdf:Description>
