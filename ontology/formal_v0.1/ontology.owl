    <rdfs:label>Agent</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="urn:zombie-game:v0.1:Remains"/>
    <owl:disjointWith rdf:resource="urn:zombie-game:v0.1:AgentState"/>
    <rdfs:subClassOf rdf:nodeID="nc4382c36279b4f628c7ca9aee3940539b71"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:zombie-game:v0.1:action_recon">
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">20.0</zg:cooldown>
    <zg:target_kind>SelfOrBroadcast</zg:target_kind>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:ReconEffect"/>
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.0</zg:stamina_cost>
    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_recon"/>
    <zg:sourceText>| `recon` | Self. Duration 2 s; 6 stamina; cooldown 20 s. On completion raise sensing radius to at least `recon_radius` (85 m) for `recon_duration` (12 s). Line of sight still applies. The effect changes subsequent observations, not past ones. |</zg:sourceText>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</zg:duration_max>
    <rdfs:label>recon</rdfs:label>
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</zg:duration_min>
  </rdf:Description>
  <rdf:Description rdf:about="urn:zombie-game:v0.1:Human">
    <rdf:type rdf:resource="urn:zombie-game:v0.1:AgentType"/>
    <zg:grants rdf:resource="urn:zombie-game:v0.1:cap_open_gate"/>
    <zg:grants rdf:resource="urn:zombie-game:v0.1:cap_close_gate"/>
