    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_claw"/>
    <zg:reach rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</zg:reach>
    <rdfs:label>claw</rdfs:label>
    <zg:sourceText>| `claw` | Living opponent within 1.5 m | 1 s | 6 / 1 s | Draw a hit. On hit, apply `zombie.claw_damage` through target physical resistance. Claw does not transmit infection. |</zg:sourceText>
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:duration_min>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:duration_max>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <zg:target_kind>Agent</zg:target_kind>
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</zg:cooldown>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:PhysicalDamageEffect"/>
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.0</zg:stamina_cost>
