  <rdf:Description rdf:about="urn:zombie-game:v0.1:biologicalType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:zombie-game:v0.1:action_scream">
    <zg:target_kind>SelfOrBroadcast</zg:target_kind>
    <zg:duration_max rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</zg:duration_max>
    <zg:sourceText>| `scream` | Optional known target/location from observation or memory, with its observation time; otherwise the actor's own location. Duration 2 s; 15 stamina; cooldown 30 s. Emit a `HUNT_CUE` signal with `call_radius` (120 m) and `call_ttl` (12 s). Zombies receive the dated payload; humans receive the source noise cue. No forced movement, global target reveal, automatic damage, or attack bonus occurs. |</zg:sourceText>
    <zg:duration_min rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</zg:duration_min>
    <rdfs:label>scream</rdfs:label>
    <zg:stamina_cost rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</zg:stamina_cost>
    <rdf:type rdf:resource="urn:zombie-game:v0.1:ActionDefinition"/>
    <zg:cooldown rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30.0</zg:cooldown>
    <zg:capability rdf:resource="urn:zombie-game:v0.1:cap_scream"/>
    <zg:coverage>PARTIAL: typed baseline parameters and shared checks; full behavioral coverage is listed in coverage.json.</zg:coverage>
    <zg:mayCause rdf:resource="urn:zombie-game:v0.1:CommunicationEffect"/>
  </rdf:Description>
